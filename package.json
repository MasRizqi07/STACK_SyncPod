{
  "name": "syncpod",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @syncpod/web --filter @syncpod/realtime dev",
    "build": "pnpm -r build",
