{
  "name": "syncpod",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @syncpod/web --filter @syncpod/realtime dev",
    "build": "pnpm -r build",
    "build:prototype": "pnpm --filter @syncpod/shared build && pnpm --filter @syncpod/db build && cross-env NEXT_PUBLIC_REALTIME_MODE=fake DEMO_MODE=false pnpm --filter @syncpod/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "db:migrate": "pnpm --filter @syncpod/db db:migrate",
    "db:seed": "pnpm --filter @syncpod/db db:seed",
    "check:secrets": "node scripts/check-secret-hygiene.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
