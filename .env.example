# Database (PostgreSQL)
DATABASE_URL="postgresql://syncpod:syncpod@localhost:5432/syncpod?schema=public"

# Auth.js (apps/web)
AUTH_SECRET="replace-with-32-byte-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ALLOWED_EMAIL_DOMAINS=""

# Realtime Auth (apps/web & apps/realtime)
REALTIME_JWT_SECRET="replace-with-32-byte-realtime-jwt-secret"

# Networking & CORS
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
REALTIME_PORT="4000"

# Google Gemini Socratic Guide (apps/realtime server only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MOCK="true"

# Demo, Sprint Timing & Timezone
DEMO_MODE="true"
APP_TIMEZONE="Asia/Jakarta"
FOCUS_SECONDS="1500"
BREAK_SECONDS="300"
MAX_ROUNDS="4"
POD_IDLE_MINUTES="15"
NEXT_TELEMETRY_DISABLED="1"
