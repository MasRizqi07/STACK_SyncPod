{
  "name": "@syncpod/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server/realtime-token.ts",
      "development": "./src/server/realtime-token.ts",
      "import": "./dist/server/realtime-token.js",
      "default": "./dist/server/realtime-token.js"
    },
    "./realtime-token": {
      "types": "./src/realtime-token.ts",
      "development": "./src/realtime-token.ts",
      "import": "./dist/realtime-token.js",
      "default": "./dist/realtime-token.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jose": "6.2.17",
    "zod": "4.6.7"
  }
}
